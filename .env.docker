# ─── Backend Secrets ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Frontend URL for CORS (your EC2 public IP or domain)
FRONTEND_URL=http://<YOUR_EC2_PUBLIC_IP>

# Supabase PostgreSQL (transaction-mode pooler for app, session-mode for migrations)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# JWT
JWT_ACCESS_SECRET=<your-jwt-secret>
JWT_ISSUER=placementhub
JWT_AUDIENCE=placementhub
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Recruiter onboarding codes
RECRUITER_SIGNUP_CODE=<your-code>
PLACEMENT_SIGNUP_CODE=<your-code>

# Job ingestion
INGEST_USE_FIXTURES=false
JOB_PARSE_LLM=true

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Gemini AI
GEMINI_API_KEY=<your-key>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# GitHub verification
GITHUB_TOKEN=<your-token>
GITHUB_TIMEOUT_MS=10000
GITHUB_MAX_REQUESTS=150
GITHUB_MAX_REPOS=6
GITHUB_MAX_FILES_PER_REPO=12
GITHUB_MAX_FILE_BYTES=100000
