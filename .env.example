# ─── Production Docker Deployment (.env) ───────────────────────────────────
# Copy this file to backend/.env or use as your root environment variables.

NODE_ENV=production
PORT=4000

# CORS: Set '*' to allow your EC2 public IP or domain name, or list comma-separated URLs
FRONTEND_URL=*

# ─── Supabase PostgreSQL ──────────────────────────────────────────────────
# Database connection string from Supabase (Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres?sslmode=require

# ─── Authentication & Security ────────────────────────────────────────────
# Generate a strong 32+ character random secret: openssl rand -base64 32
JWT_ACCESS_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ISSUER=placementhub
JWT_AUDIENCE=placementhub
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ─── Secret Codes for Portal Registration ─────────────────────────────────
RECRUITER_SIGNUP_CODE=RECRUIT2026
PLACEMENT_SIGNUP_CODE=PLACE2026

# ─── AI & Verification ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
JOB_PARSE_LLM=true
INGEST_USE_FIXTURES=false

# ─── GitHub Token (To prevent rate-limiting when verifying code) ───────────
GITHUB_TOKEN=
GITHUB_TIMEOUT_MS=10000
GITHUB_MAX_REQUESTS=150
GITHUB_MAX_REPOS=6
GITHUB_MAX_FILES_PER_REPO=12
GITHUB_MAX_FILE_BYTES=100000

# ─── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
