# ─── Server Configuration ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# CORS: Set '*' to allow any origin (e.g. EC2 public IP or domain), or comma-separated origins
FRONTEND_URL=*

# ─── Database (Supabase / PostgreSQL) ──────────────────────────────────────
# Transaction-mode connection pooler URL (e.g. port 6543 or 5432 with ?sslmode=require)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Direct session connection URL for migrations
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# ─── Authentication & Security (JWT) ──────────────────────────────────────
# Generate a strong 32+ character random secret: openssl rand -base64 32
JWT_ACCESS_SECRET=your-secure-jwt-secret-at-least-32-characters-long
JWT_ISSUER=placementhub
JWT_AUDIENCE=placementhub
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ─── Onboarding Invitation Codes ──────────────────────────────────────────
# Students can register freely; recruiters and placement teams need these secret codes
RECRUITER_SIGNUP_CODE=RECRUIT2026
PLACEMENT_SIGNUP_CODE=PLACE2026

# ─── Google Gemini AI (Resume Parsing & Skill Assessments) ────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Job parsing mode: true = parse via Gemini, false = fallback heuristic rules
JOB_PARSE_LLM=true
INGEST_USE_FIXTURES=false

# ─── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# ─── GitHub API Verification (Optional) ───────────────────────────────────
# GitHub personal access token (classic or fine-grained read-only) to avoid 60 req/hr rate limits
GITHUB_TOKEN=
GITHUB_TIMEOUT_MS=10000
GITHUB_MAX_REQUESTS=150
GITHUB_MAX_REPOS=6
GITHUB_MAX_FILES_PER_REPO=12
GITHUB_MAX_FILE_BYTES=100000
