FROM oven/bun:1
WORKDIR /var/www/kurukshetra-web

COPY ./frontend/package.json ./package.json
COPY ./frontend/bun.lock* ./

# Install dependencies (fetches glibc Linux native bindings for Vite & Rolldown)
RUN bun install

# Copy frontend source files
COPY ./frontend ./

# Build frontend
RUN bun run build

EXPOSE 5173

CMD ["bun", "run", "preview", "--host", "0.0.0.0", "--port", "5173"]
