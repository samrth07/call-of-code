# ─── Frontend Environment Configuration ────────────────────────────────────
# Optional: In development or behind Nginx reverse proxy, leave this blank.
# The app will automatically default to relative '/api/v1', preventing all CORS issues.
# If connecting directly to an external backend on a different domain or port, set the full URL:
# VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_API_BASE_URL=
